# 复制为 backend/.env 后填入自己的 Key。不要把 .env 提交到 Git。
# 默认按硅基流动（OpenAI 兼容）配置；换供应商时改下面四项即可。

# ===== 对话模型 =====
LLM_API_KEY=sk-在这里填你的Key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
# 仅 DeepSeek Flash/V4：enabled / disabled；其他供应商留空
LLM_THINKING=

# ===== 向量模型 =====
# EMBED_MODE=api    调用 /embeddings（默认，复用上面的 Key 和 Base URL）
# EMBED_MODE=local  本地哈希向量，不调用接口（DeepSeek 必须用这个，或另配 EMBED_*）
# 留空自动判断：Base URL 是 DeepSeek 时自动用 local
EMBED_MODE=
# 向量模型和对话模型不同供应商时，单独填这两项
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3

# ===== 可选重排（没有就留空）=====
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL=

# ===== 检索参数 =====
TOP_K=5
CANDIDATE_K=20
# 向量余弦阈值；低于该值直接回答“资料未涵盖”
MIN_SCORE=0.40
CHUNK_SIZE=480
CHUNK_OVERLAP=80

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
